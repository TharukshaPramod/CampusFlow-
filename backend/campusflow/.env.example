# Backend database (Supabase/PostgreSQL)
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SUPABASE_DB_HOST=<host>
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=<database>
SUPABASE_DB_USER=<username>
SUPABASE_DB_PASSWORD=<password>

# Supabase API
SUPABASE_API_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# JWT and app
JWT_SECRET=<hex-or-random-secret>
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
